#!/usr/bin/env bash
set -euo pipefail

DRY_RUN="${DRY_RUN:-0}"
IF_CHANGED=0
FORCE_RELOAD_POLYBAR=0
NO_POLYBAR=0
NO_WALLPAPER=0
MODE="apply"
LAPTOP_SCALE="${LAPTOP_SCALE:-auto}"
I3_SCRIPTS_DIR="${I3_SCRIPTS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/i3/scripts}"

usage() {
  cat <<'EOF'
Uso:
  i3_screenlayout [opciones]

Modos:
  --apply              Detecta monitores conectados y aplica configuracion xrandr (por defecto).
  --watch              Escucha eventos RandR (X11) y DRM (udev) para recargar monitores al conectar/desconectar.

Opciones:
  --if-changed         Solo reaplica xrandr si cambio la topologia o hay salidas pendientes.
  --reload-polybar     Fuerza la recarga de Polybar tras aplicar el layout.
  --no-polybar         No recarga Polybar tras aplicar el layout.
  --no-wallpaper       No reajusta el wallpaper con i3_wallpaper.
  --laptop-scale VAL   Escala para pantalla de laptop (ej. 1.25, 1.33, 1.5, 1.0, auto).
  --dry-run            Muestra monitores detectados y comando xrandr sin aplicar cambios.
  -h, --help           Muestra esta ayuda.
EOF
}

log() { echo "[INFO] $*" >&2; }
warn() { echo "[WARN] $*" >&2; }
err() { echo "[ERROR] $*" >&2; }
dry() { echo "[DRY-RUN] $*" >&2; }

while (($# > 0)); do
  case "$1" in
    --apply)
      MODE="apply"
      shift
      ;;
    --watch)
      MODE="watch"
      shift
      ;;
    --if-changed)
      IF_CHANGED=1
      shift
      ;;
    --reload-polybar)
      FORCE_RELOAD_POLYBAR=1
      shift
      ;;
    --no-polybar)
      NO_POLYBAR=1
      shift
      ;;
    --no-wallpaper)
      NO_WALLPAPER=1
      shift
      ;;
    --laptop-scale)
      if (($# < 2)); then
        err "--laptop-scale requiere un valor."
        usage >&2
        exit 1
      fi
      LAPTOP_SCALE="$2"
      shift 2
      ;;
    --laptop-scale=*)
      LAPTOP_SCALE="${1#*=}"
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      err "Opcion no reconocida: $1"
      usage >&2
      exit 1
      ;;
  esac
done

is_laptop_system() {
  if [[ -r /sys/class/dmi/id/chassis_type ]]; then
    local chassis
    chassis="$(< /sys/class/dmi/id/chassis_type)"
    case "$chassis" in
      8|9|10|11|14|31|32) return 0 ;;
    esac
  fi

  if compgen -G "/sys/class/power_supply/BAT*" >/dev/null; then
    return 0
  fi

  return 1
}

is_laptop_monitor() {
  local mon="$1"
  if [[ "$mon" =~ ^(eDP|LVDS|DSI) ]]; then
    return 0
  fi
  if is_laptop_system && [[ "$mon" =~ (eDP|LVDS|DSI) ]]; then
    return 0
  fi
  return 1
}

get_monitor_details() {
  local mon="$1"
  local xrandr_out="$2"

  printf '%s\n' "$xrandr_out" | awk -v m="$mon" '
    function pick_max_rate(line,   n, i, tok, val, max_val, max_r) {
      n = split(line, parts, /[[:space:]]+/)
      max_val = 0
      max_r = ""
      for (i = 2; i <= n; i++) {
        tok = parts[i]
        gsub(/[*+]/, "", tok)
        if (tok ~ /^[0-9]+(\.[0-9]+)?$/) {
          val = tok + 0
          if (val > max_val) {
            max_val = val
            max_r = tok
          }
        }
      }
      if (max_r != "") {
        sub(/\.0+$/, "", max_r)
        return max_r
      }
      return "-"
    }
    $1 == m && $2 == "connected" {
      inside=1
      if (match($0, /([0-9]+)mm x ([0-9]+)mm/, sz)) {
        w_mm = sz[1]
        h_mm = sz[2]
      } else {
        w_mm = 0
        h_mm = 0
      }
      next
    }
    inside && /^[^[:space:]]/ {
      if (!printed && first_mode != "") {
        print first_mode, first_rate, (w_mm ? w_mm : 0), (h_mm ? h_mm : 0)
        printed=1
      }
      inside=0
      exit
    }
    inside && $1 ~ /^[0-9]+x[0-9]+$/ {
      if (first_mode == "") {
        first_mode = $1
        first_rate = pick_max_rate($0)
      }
      if ($0 ~ /\+/) {
        print $1, pick_max_rate($0), (w_mm ? w_mm : 0), (h_mm ? h_mm : 0)
        printed=1
        exit
      }
    }
    END {
      if (!printed && first_mode != "") {
        print first_mode, first_rate, (w_mm ? w_mm : 0), (h_mm ? h_mm : 0)
      }
    }
  '
}

calculate_laptop_scale() {
  local width="$1"
  local height="$2"
  local width_mm="${3:-0}"
  local height_mm="${4:-0}"
  local requested_scale="${LAPTOP_SCALE:-auto}"

  local dpi=0
  if (( width_mm > 0 )); then
    dpi=$(( (width * 254 + width_mm * 5) / (width_mm * 10) ))
  fi

  local scale_ui="1.0"
  if [[ -n "$requested_scale" && "$requested_scale" != "auto" ]]; then
    scale_ui="$requested_scale"
  else
    if (( dpi >= 220 )); then
      scale_ui="1.5"
    elif (( dpi >= 165 )); then
      scale_ui="1.25"
    elif (( dpi >= 140 )); then
      scale_ui="1.25"
    elif (( dpi == 0 && (width >= 2560 || height >= 1440) )); then
      scale_ui="1.25"
    else
      scale_ui="1.0"
    fi
  fi

  awk -v w="$width" -v h="$height" -v s="$scale_ui" -v d="$dpi" '
    BEGIN {
      if (s ~ /^[0-9]+(\.[0-9]+)?$/ && s > 0) {
        if (s < 1.0 && s >= 0.3) {
          factor = s + 0.0
          ui_scale = 1.0 / factor
        } else {
          ui_scale = s + 0.0
          factor = 1.0 / ui_scale
        }
      } else {
        factor = 1.0
        ui_scale = 1.0
      }

      factor_str = sprintf("%.4f", factor)
      sub(/\.?0+$/, "", factor_str)
      if (factor_str == "") factor_str = "1"

      ui_str = sprintf("%.2f", ui_scale)
      sub(/\.?0+$/, "", ui_str)

      lw = int(w * factor + 0.5)
      lh = int(h * factor + 0.5)

      printf "%sx%s %d %d %s %d\n", factor_str, factor_str, lw, lh, ui_str, d
    }
  '
}

runtime_base_prefix() {
  local display_id="${DISPLAY:-none}"
  local display_safe="${display_id//[^a-zA-Z0-9_.-]/_}"
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  printf '%s/i3-screenlayout-%s-%s' "$runtime_dir" "$UID" "$display_safe"
}

apply_layout() {
  if ! command -v xrandr >/dev/null 2>&1; then
    warn "xrandr no esta disponible. Se omite configuracion de pantalla."
    return 0
  fi

  local base_prefix
  base_prefix="$(runtime_base_prefix)"
  local lock_file="${base_prefix}.apply.lock"
  local state_file="${base_prefix}.state"

  if [[ $DRY_RUN -eq 0 ]] && command -v flock >/dev/null 2>&1; then
    exec 9>"$lock_file"
    flock 9
  fi

  local xrandr_out
  if ! xrandr_out="$(xrandr --query 2>/dev/null)"; then
    warn "No se pudo consultar xrandr. Se omite configuracion de pantalla."
    exec 9>&- 2>/dev/null || true
    return 0
  fi

  local connected=()
  local inactive_connected=()
  local disconnected_active=()

  mapfile -t connected < <(printf '%s\n' "$xrandr_out" | awk '$2 == "connected" {print $1}')
  if ((${#connected[@]} < 1)); then
    warn "No se detectaron pantallas conectadas."
    exec 9>&- 2>/dev/null || true
    return 0
  fi

  mapfile -t inactive_connected < <(printf '%s\n' "$xrandr_out" | awk '$2 == "connected" && !/[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {print $1}')
  mapfile -t disconnected_active < <(printf '%s\n' "$xrandr_out" | awk '$2 == "disconnected" && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {print $1}')

  local mon
  local need_retry=0
  for mon in "${connected[@]}"; do
    local probe_mode="" _r="" _w="" _h=""
    read -r probe_mode _r _w _h < <(get_monitor_details "$mon" "$xrandr_out") || true
    if [[ -z "$probe_mode" ]]; then
      need_retry=1
      break
    fi
  done

  # Al conectar un hub USB-C / MST, el EDID puede tardar unos milisegundos en reportar modos.
  if [[ $need_retry -eq 1 && $DRY_RUN -eq 0 ]]; then
    sleep 0.8
    if ! xrandr_out="$(xrandr --query 2>/dev/null)"; then
      warn "No se pudo consultar xrandr tras reintento."
      exec 9>&- 2>/dev/null || true
      return 0
    fi

    mapfile -t connected < <(printf '%s\n' "$xrandr_out" | awk '$2 == "connected" {print $1}')
    if ((${#connected[@]} < 1)); then
      warn "No se detectaron pantallas conectadas."
      exec 9>&- 2>/dev/null || true
      return 0
    fi

    mapfile -t inactive_connected < <(printf '%s\n' "$xrandr_out" | awk '$2 == "connected" && !/[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {print $1}')
    mapfile -t disconnected_active < <(printf '%s\n' "$xrandr_out" | awk '$2 == "disconnected" && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {print $1}')
  fi

  local monitor_specs=()
  local primary_mon=""
  local primary_spec=""
  local primary_area=0
  local incomplete_topology=0

  for mon in "${connected[@]}"; do
    local mode="" rate="" width_mm=0 height_mm=0
    read -r mode rate width_mm height_mm < <(get_monitor_details "$mon" "$xrandr_out") || true

    if [[ -z "$mode" ]]; then
      warn "Monitor ${mon} conectado sin modos disponibles aun; se omite en este intento"
      incomplete_topology=1
      continue
    fi

    if [[ "$rate" == "-" ]]; then
      rate=""
    fi

    local width="${mode%x*}"
    local height="${mode#*x}"
    if ! [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]]; then
      warn "Monitor ${mon} reporto modo invalido (${mode}); se omite en este intento"
      incomplete_topology=1
      continue
    fi

    local scale_xr="1x1"
    local log_w="$width"
    local log_h="$height"
    local scale_ui="1.0"
    local dpi=0

    if is_laptop_monitor "$mon"; then
      read -r scale_xr log_w log_h scale_ui dpi < <(calculate_laptop_scale "$width" "$height" "$width_mm" "$height_mm")
      if [[ "$scale_xr" != "1x1" ]]; then
        log "Monitor de laptop detectado: ${mon} (${mode}, DPI: ${dpi}, escala visual: ${scale_ui}x, xrandr: ${scale_xr}, resolucion logica: ${log_w}x${log_h})"
      else
        log "Monitor de laptop detectado: ${mon} (${mode}, DPI: ${dpi}, escala: 1.0x)"
      fi
    else
      log "Monitor externo detectado: ${mon} (${mode}, sin escalado)"
    fi

    local area=$((width * height))
    monitor_specs+=("${log_w}|${mon}|${mode}|${rate}|${scale_xr}|${log_h}")

    if (( area > primary_area )) || [[ -z "$primary_mon" ]]; then
      primary_area=$area
      primary_mon="$mon"
      primary_spec="${log_w}|${mon}|${mode}|${rate}|${scale_xr}|${log_h}|1"
    fi
  done

  if ((${#monitor_specs[@]} == 0)); then
    warn "No se detectaron monitores conectados con modos validos."
    exec 9>&- 2>/dev/null || true
    return 0
  fi

  local ordered_specs=()
  if ((${#monitor_specs[@]} == 1)); then
    ordered_specs+=("${primary_spec}")
  else
    while IFS='|' read -r log_w mon mode rate scale_xr log_h; do
      if [[ "$mon" != "$primary_mon" ]]; then
        ordered_specs+=("${log_w}|${mon}|${mode}|${rate}|${scale_xr}|${log_h}|0")
      fi
    done < <(printf '%s\n' "${monitor_specs[@]}" | sort -s -n -t '|' -k1,1)

    ordered_specs+=("${primary_spec}")
  fi

  local desired_signature="scale=${LAPTOP_SCALE};disc=0"
  local sig_spec
  for sig_spec in "${ordered_specs[@]}"; do
    local s_log_w s_mon s_mode s_rate s_scale_xr s_log_h s_is_prim
    IFS='|' read -r s_log_w s_mon s_mode s_rate s_scale_xr s_log_h s_is_prim <<< "$sig_spec"
    desired_signature+=$'\n'"${s_mon}|${s_mode}|${s_rate}|${s_scale_xr}|${s_log_w}|${s_log_h}|${s_is_prim}"
  done

  if [[ $IF_CHANGED -eq 1 && $DRY_RUN -eq 0 ]]; then
    local saved_signature=""
    if [[ -f "$state_file" ]]; then
      saved_signature="$(< "$state_file")"
    fi

    if [[ $incomplete_topology -eq 0 \
       && -n "$saved_signature" \
       && "$saved_signature" == "$desired_signature" \
       && ${#inactive_connected[@]} -eq 0 \
       && ${#disconnected_active[@]} -eq 0 ]]; then
      log "Topologia de monitores sin cambios; no se reaplica xrandr."
      exec 9>&- 2>/dev/null || true
      return 0
    fi
  fi

  local xrandr_args=()
  local xrandr_args_norate=()
  local xrandr_args_auto=()
  local display_lines=()
  local has_rate=0
  local off_mon

  for off_mon in "${disconnected_active[@]}"; do
    xrandr_args+=(--output "$off_mon" --off)
    xrandr_args_norate+=(--output "$off_mon" --off)
    xrandr_args_auto+=(--output "$off_mon" --off)
    display_lines+=("       --output ${off_mon} --off \\")
  done

  local x_pos=0
  local prev_mon=""
  local spec
  for spec in "${ordered_specs[@]}"; do
    local log_w mon mode rate scale_xr log_h is_prim
    IFS='|' read -r log_w mon mode rate scale_xr log_h is_prim <<< "$spec"

    local base_args=(--output "$mon")
    if [[ "$is_prim" -eq 1 ]]; then
      base_args+=(--primary)
    fi
    base_args+=(--mode "$mode")

    local rate_args=()
    if [[ -n "$rate" ]]; then
      rate_args=(--rate "$rate")
      has_rate=1
    fi

    local tail_args=(--pos "${x_pos}x0" --rotate normal)
    if [[ "$scale_xr" != "1x1" ]]; then
      tail_args+=(--scale "$scale_xr" --panning "${log_w}x${log_h}+${x_pos}+0")
    fi

    xrandr_args+=("${base_args[@]}" "${rate_args[@]}" "${tail_args[@]}")
    xrandr_args_norate+=("${base_args[@]}" "${tail_args[@]}")

    xrandr_args_auto+=(--output "$mon")
    if [[ "$is_prim" -eq 1 ]]; then
      xrandr_args_auto+=(--primary)
    fi
    xrandr_args_auto+=(--auto)
    if [[ -n "$prev_mon" ]]; then
      xrandr_args_auto+=(--right-of "$prev_mon")
    fi
    prev_mon="$mon"

    local line="       --output ${mon}"
    if [[ "$is_prim" -eq 1 ]]; then
      line+=" --primary"
    fi
    line+=" --mode ${mode}"
    if [[ -n "$rate" ]]; then
      line+=" --rate ${rate}"
    fi
    line+=" --pos ${x_pos}x0 --rotate normal"
    if [[ "$scale_xr" != "1x1" ]]; then
      line+=" --scale ${scale_xr} --panning ${log_w}x${log_h}+${x_pos}+0"
    fi
    line+=" \\"

    display_lines+=("$line")
    x_pos=$((x_pos + log_w))
  done

  if ((${#display_lines[@]} > 0)); then
    local last_index=$((${#display_lines[@]} - 1))
    display_lines[$last_index]="${display_lines[$last_index]% \\}"
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    dry "Comando xrandr propuesto:"
    dry "xrandr \\"
    local cl
    for cl in "${display_lines[@]}"; do
      dry "$cl"
    done
    return 0
  fi

  local applied=0
  if xrandr "${xrandr_args[@]}"; then
    applied=1
  else
    if [[ $has_rate -eq 1 ]]; then
      warn "Fallo xrandr con --rate explicito (posible limite de ancho de banda en hub USB-C); reintentando sin --rate."
      if xrandr "${xrandr_args_norate[@]}"; then
        applied=1
      fi
    fi

    if [[ $applied -eq 0 ]]; then
      warn "Fallo xrandr con modo explicito; reintentando con --auto."
      if xrandr "${xrandr_args_auto[@]}"; then
        applied=1
      fi
    fi
  fi

  if [[ $applied -eq 0 ]]; then
    err "No se pudo aplicar la configuracion de pantalla con xrandr."
    exec 9>&- 2>/dev/null || true
    return 1
  fi

  log "Configuracion de pantalla aplicada correctamente"

  if [[ $incomplete_topology -eq 0 ]]; then
    local tmp_state
    tmp_state="$(mktemp "${state_file}.XXXXXX")"
    printf '%s\n' "$desired_signature" > "$tmp_state"
    mv -f "$tmp_state" "$state_file"
  else
    rm -f "$state_file"
  fi

  exec 9>&- 2>/dev/null || true

  if [[ $NO_WALLPAPER -eq 0 && -x "${I3_SCRIPTS_DIR}/i3_wallpaper" ]]; then
    "${I3_SCRIPTS_DIR}/i3_wallpaper" || warn "Fallo al reajustar wallpaper con i3_wallpaper."
  fi

  if [[ $NO_POLYBAR -eq 0 && -x "${I3_SCRIPTS_DIR}/i3_polybar_set_theme" && -d "${HOME}/.config/polybar" ]]; then
    local polybar_running=0
    if command -v pgrep >/dev/null 2>&1 && pgrep -u "$UID" -x polybar >/dev/null 2>&1; then
      polybar_running=1
    fi

    if [[ $FORCE_RELOAD_POLYBAR -eq 1 || $polybar_running -eq 1 ]]; then
      log "Recargando Polybar para adaptar barras a los monitores activos..."
      (
        trap '' HUP
        exec 9>&- 2>/dev/null || true
        "${I3_SCRIPTS_DIR}/i3_polybar_set_theme" --current </dev/null >/dev/null 2>&1
      ) &
    fi
  fi
}

watch_layout() {
  if ! command -v python3 >/dev/null 2>&1; then
    err "Se requiere python3 para ejecutar --watch."
    return 1
  fi

  local self_path
  self_path="$(readlink -f "${BASH_SOURCE[0]}")"
  local pid_file
  pid_file="$(runtime_base_prefix).watch.pid"

  exec python3 - "$self_path" "$LAPTOP_SCALE" "$pid_file" "$NO_WALLPAPER" "$NO_POLYBAR" <<'PYEOF'
import ctypes
import fcntl
import os
import select
import shutil
import signal
import subprocess
import sys
import time

self_path = sys.argv[1]
laptop_scale = sys.argv[2]
pid_file = sys.argv[3]
no_wallpaper = sys.argv[4] == "1"
no_polybar = sys.argv[5] == "1"

DEBOUNCE_SEC = 1.2
MAX_DEBOUNCE_SEC = 3.0
POST_APPLY_DRAIN_SEC = 0.3

stop_requested = False


def handle_stop(signum, frame):
    global stop_requested
    stop_requested = True


signal.signal(signal.SIGTERM, handle_stop)
signal.signal(signal.SIGINT, handle_stop)


def terminate_existing_watcher():
    if not os.path.exists(pid_file):
        return
    try:
        with open(pid_file, "r", encoding="utf-8") as f:
            raw = f.read().strip()
        old_pid = int(raw)
    except Exception:
        return

    if old_pid <= 1 or old_pid == os.getpid():
        return

    cmdline_path = f"/proc/{old_pid}/cmdline"
    try:
        with open(cmdline_path, "rb") as f:
            cmdline = f.read()
    except OSError:
        return

    if b"i3_screenlayout" not in cmdline or b".watch.pid" not in cmdline:
        return

    try:
        os.kill(old_pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except OSError:
        return

    deadline = time.monotonic() + 1.0
    while time.monotonic() < deadline:
        try:
            os.kill(old_pid, 0)
        except ProcessLookupError:
            break
        except OSError:
            break
        time.sleep(0.05)


def acquire_watch_lock():
    lock_path = pid_file + ".lock"
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
    deadline = time.monotonic() + 2.0
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock_fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(lock_fd)
                sys.stderr.write("[ERROR] Otro watcher de i3_screenlayout sigue activo.\n")
                raise SystemExit(1)
            time.sleep(0.05)


def setup_x11_randr():
    if not os.environ.get("DISPLAY"):
        return None
    try:
        x11 = ctypes.CDLL("libX11.so.6")
        xrr = ctypes.CDLL("libXrandr.so.2")

        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x11.XDefaultRootWindow.restype = ctypes.c_ulong
        x11.XConnectionNumber.argtypes = [ctypes.c_void_p]
        x11.XConnectionNumber.restype = ctypes.c_int
        x11.XFlush.argtypes = [ctypes.c_void_p]
        x11.XFlush.restype = ctypes.c_int
        x11.XPending.argtypes = [ctypes.c_void_p]
        x11.XPending.restype = ctypes.c_int
        x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        x11.XNextEvent.restype = ctypes.c_int
        x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
        x11.XCloseDisplay.restype = ctypes.c_int

        xrr.XRRQueryExtension.argtypes = [
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int),
        ]
        xrr.XRRQueryExtension.restype = ctypes.c_int
        xrr.XRRSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int]
        xrr.XRRSelectInput.restype = None

        dpy = x11.XOpenDisplay(None)
        if not dpy:
            return None

        ev_base = ctypes.c_int()
        err_base = ctypes.c_int()
        if not xrr.XRRQueryExtension(dpy, ctypes.byref(ev_base), ctypes.byref(err_base)):
            x11.XCloseDisplay(dpy)
            return None

        root = x11.XDefaultRootWindow(dpy)
        # RRScreenChangeNotifyMask (1 << 0) | RROutputChangeNotifyMask (1 << 2)
        xrr.XRRSelectInput(dpy, root, (1 << 0) | (1 << 2))
        x11.XFlush(dpy)
        fd = x11.XConnectionNumber(dpy)
        return (x11, dpy, fd)
    except Exception as exc:
        sys.stderr.write(f"[WARN] No se pudo iniciar listener X11 RandR: {exc}\n")
        return None


def setup_udev_drm():
    udevadm_bin = shutil.which("udevadm")
    if not udevadm_bin:
        return None

    def set_pdeathsig():
        try:
            libc = ctypes.CDLL("libc.so.6")
            libc.prctl(1, signal.SIGTERM)
        except Exception:
            pass

    try:
        proc = subprocess.Popen(
            [udevadm_bin, "monitor", "--udev", "--subsystem-match=drm"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=False,
            bufsize=0,
            preexec_fn=set_pdeathsig,
        )
        fd = proc.stdout.fileno()
        os.set_blocking(fd, False)
        return (proc, fd)
    except Exception as exc:
        sys.stderr.write(f"[WARN] No se pudo iniciar listener udev DRM: {exc}\n")
        return None


def build_apply_cmd(reload_polybar: bool):
    cmd = [self_path, "--apply", "--if-changed", "--laptop-scale", laptop_scale]
    if reload_polybar:
        cmd.append("--reload-polybar")
    if no_wallpaper:
        cmd.append("--no-wallpaper")
    if no_polybar:
        cmd.append("--no-polybar")
    return cmd


def main():
    terminate_existing_watcher()
    lock_fd = acquire_watch_lock()

    wakeup_r, wakeup_w = os.pipe()
    os.set_blocking(wakeup_r, False)
    os.set_blocking(wakeup_w, False)
    prev_wakeup_fd = signal.set_wakeup_fd(wakeup_w, warn_on_full_buffer=False)

    x11_state = None
    udev_state = None

    try:
        with open(pid_file, "w", encoding="utf-8") as f:
            f.write(f"{os.getpid()}\n")

        x11_state = setup_x11_randr()
        udev_state = setup_udev_drm()

        watch_fds = [wakeup_r]
        if x11_state is not None:
            watch_fds.append(x11_state[2])
        if udev_state is not None:
            watch_fds.append(udev_state[1])

        if len(watch_fds) <= 1:
            sys.stderr.write("[ERROR] No hay fuentes de eventos disponibles (X11 RandR ni udev DRM).\n")
            raise SystemExit(1)

        udev_buf = b""
        xev = (ctypes.c_long * 24)()

        def drain_x11():
            if x11_state is None:
                return 0
            x11, dpy, _ = x11_state
            count = 0
            while x11.XPending(dpy) > 0:
                x11.XNextEvent(dpy, ctypes.byref(xev))
                count += 1
            return count

        def read_udev():
            nonlocal udev_buf, udev_state
            if udev_state is None:
                return False
            proc, fd = udev_state
            got_drm = False
            while True:
                try:
                    chunk = os.read(fd, 4096)
                except BlockingIOError:
                    break
                except OSError:
                    chunk = b""

                if not chunk:
                    if fd in watch_fds:
                        watch_fds.remove(fd)
                    try:
                        proc.stdout.close()
                    except Exception:
                        pass
                    udev_state = None
                    break

                udev_buf += chunk

            while b"\n" in udev_buf:
                line, udev_buf = udev_buf.split(b"\n", 1)
                if b"(drm)" in line:
                    got_drm = True
            return got_drm

        def drain_readable(readable_fds):
            if wakeup_r in readable_fds:
                try:
                    os.read(wakeup_r, 1024)
                except OSError:
                    pass
            triggered = False
            if x11_state is not None and x11_state[2] in readable_fds:
                if drain_x11() > 0:
                    triggered = True
            if udev_state is not None and udev_state[1] in readable_fds:
                if read_udev():
                    triggered = True
            return triggered

        # Sincronizacion inicial al arrancar watcher (sin forzar polybar en arranque frio).
        subprocess.run(build_apply_cmd(reload_polybar=False), check=False)

        # Drena eventos pendientes iniciales para evitar disparo duplicado inmediato.
        drain_x11()
        if udev_state is not None:
            read_udev()

        while not stop_requested and len(watch_fds) > 1:
            try:
                readable, _, _ = select.select(watch_fds, [], [], 5.0)
            except InterruptedError:
                continue

            if stop_requested:
                break
            if not readable:
                continue
            if not drain_readable(readable):
                continue

            first_ts = time.monotonic()
            last_ts = first_ts

            while not stop_requested and len(watch_fds) > 1:
                now = time.monotonic()
                rem_idle = (last_ts + DEBOUNCE_SEC) - now
                rem_max = (first_ts + MAX_DEBOUNCE_SEC) - now
                wait_s = min(rem_idle, rem_max)
                if wait_s <= 0:
                    break

                try:
                    r, _, _ = select.select(watch_fds, [], [], wait_s)
                except InterruptedError:
                    continue

                if stop_requested or not r:
                    break
                if drain_readable(r):
                    last_ts = time.monotonic()

            if stop_requested:
                break

            subprocess.run(build_apply_cmd(reload_polybar=True), check=False)

            drain_end = time.monotonic() + POST_APPLY_DRAIN_SEC
            while not stop_requested and len(watch_fds) > 1:
                rem = drain_end - time.monotonic()
                if rem <= 0:
                    break
                try:
                    r, _, _ = select.select(watch_fds, [], [], rem)
                except InterruptedError:
                    continue
                if not r:
                    break
                drain_readable(r)
    finally:
        try:
            signal.set_wakeup_fd(prev_wakeup_fd)
        except Exception:
            pass
        for fd in (wakeup_r, wakeup_w):
            try:
                os.close(fd)
            except Exception:
                pass
        if udev_state is not None:
            proc, _ = udev_state
            try:
                proc.terminate()
                proc.wait(timeout=1.0)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        if x11_state is not None:
            try:
                x11_state[0].XCloseDisplay(x11_state[1])
            except Exception:
                pass
        try:
            if os.path.exists(pid_file):
                with open(pid_file, "r", encoding="utf-8") as f:
                    if f.read().strip() == str(os.getpid()):
                        os.unlink(pid_file)
        except Exception:
            pass
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)
        except Exception:
            pass


if __name__ == "__main__":
    main()
PYEOF
